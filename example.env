##########################################
## Firefox SyncStorage RS Configuration ##
##########################################

# URL clients will use to connect to the sync server (https://hostname:8000)
# If you use a reverse proxy, that URL should be used here (https://sync.example.com)
# This is also used to bootstrap the sync-1.5 node in the tokenserver.
SYNC_URL=

# Database backend to use: "postgres" or "mysql".
# This selects both the compiled backend (build arg) and the tokenserver node type.
SYNC_BACKEND=postgres

# Which docker compose profile (database container) to start. Set this to the
# same value as SYNC_BACKEND ("postgres" or "mysql").
COMPOSE_PROFILES=postgres

# Master sync key (must be 64 characters long)
# Use: `cat /dev/urandom | base32 | head -c64` to generate a random value
SYNC_MASTER_SECRET=

# Hashing secret (must be 64 characters long)
# Use: `cat /dev/urandom | base32 | head -c64` to generate a random value
METRICS_HASH_SECRET=

##########################################
## PostgreSQL (default)                 ##
##########################################

# Password for the "sync" postgres user (should be random)
POSTGRES_PASSWORD=

# PostgreSQL shares a single database between syncstorage and tokenserver.
SYNC_SYNCSTORAGE__DATABASE_URL=postgres://sync:${POSTGRES_PASSWORD}@postgres:5432/syncserver
SYNC_TOKENSERVER__DATABASE_URL=postgres://sync:${POSTGRES_PASSWORD}@postgres:5432/syncserver

##########################################
## MySQL / MariaDB (alternative)        ##
##########################################
# To use MySQL instead of PostgreSQL:
#   - set SYNC_BACKEND=mysql and COMPOSE_PROFILES=mysql above
#   - fill in the passwords below
#   - use the two mysql:// DATABASE_URLs below (comment out the postgres ones)

# MySQL passwords (should be random)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# MySQL uses two separate databases (created by data/initdb.d/init.sql).
#SYNC_SYNCSTORAGE__DATABASE_URL=mysql://sync:${MYSQL_PASSWORD}@mariadb:3306/syncstorage_rs
#SYNC_TOKENSERVER__DATABASE_URL=mysql://sync:${MYSQL_PASSWORD}@mariadb:3306/tokenserver_rs
